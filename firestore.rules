rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /bonos/{code} {
      allow create: if request.resource.data.keys().hasAll(
            ['name','phone','service','totalSessions','usedSessions','createdAt','expiresAt']
          )
          && request.resource.data.usedSessions == 0
          && request.resource.data.totalSessions is int
          && !exists(/databases/$(database)/documents/bonos/$(code));
      allow read: if true;
      allow update: if request.auth != null
          && request.resource.data.usedSessions is int
          && request.resource.data.usedSessions >= resource.data.usedSessions
          && request.resource.data.usedSessions <= resource.data.totalSessions;
      allow delete: if false;
    }

    match /horarios/{fecha} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /reservas/{reservaId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(
            ['date','time','name','phone','service','depositPaid','status']
          )
          && request.resource.data.depositPaid == true
          && request.resource.data.status == 'pendiente_confirmacion'
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.phone is string
          && request.resource.data.phone.size() > 0;
      allow update: if request.auth != null
          && request.resource.data.date == resource.data.date
          && request.resource.data.time == resource.data.time
          && request.resource.data.name == resource.data.name
          && request.resource.data.phone == resource.data.phone
          && (request.resource.data.status == 'confirmada'
              || request.resource.data.status == 'cancelada'
              || request.resource.data.status == 'pendiente_confirmacion');
      allow delete: if false;
    }

    match /giftcards/{code} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(
            ['recipient','service','price','redeemed','createdAt','expiresAt']
          )
          && request.resource.data.redeemed == false
          && request.resource.data.price is number
          && !exists(/databases/$(database)/documents/giftcards/$(code));
      allow update: if request.auth != null
          && request.resource.data.redeemed == true
          && resource.data.redeemed == false
          && request.resource.data.recipient == resource.data.recipient
          && request.resource.data.price == resource.data.price;
      allow delete: if false;
    }
  }
}
